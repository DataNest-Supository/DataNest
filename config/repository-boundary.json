{
  "schemaVersion": "datanest-repository-boundary-v1",
  "authority": "DataNest-Supository/DataNest",
  "mirrorRepository": "DataNest-Supository/Mirror-DataNest",
  "defaultPolicy": "unclassified",
  "ruleOrder": "first-match-wins",
  "pathRules": [
    {
      "policy": "canonical_only",
      "patterns": [
        ".github/workflows/mirror-production-import.yml",
        ".github/workflows/notify-mirror-canonical.yml",
        "DEVELOPER_COORDINATION.md",
        "config/repository-boundary.json",
        "schemas/release-evidence-envelope-v1.schema.json",
        "scripts/lib/repository-boundary.mjs",
        "scripts/validate-mirror-candidate-boundary.mjs",
        "scripts/write-release-manifest.mjs",
        "scripts/write-ui-governance-evidence.mjs",
        "config/worktree-gate-timeframes.json",
        "config/production-edge-function-attestation.json",
        "config/supository.catalog.json",
        "docs/DATANEST_SUPOSITORY_ARCHITECTURE.md",
        "docs/MIRROR_DATANEST_PROMOTION.md",
        "infra/reson8-forge/evidence-ingest/**",
        "infra/reson8-forge/scripts/ingest-release-evidence.sh",
        "infra/reson8-forge/scripts/validate-recovery-bundle.sh",
        "infra/reson8-forge/scripts/verify-backup.sh",
        "scripts/forge-index-release-evidence.mjs",
        "scripts/verify-production-edge-function-attestation.mjs",
        "scripts/verify-production-edge-function-release-reference.mjs",
        "scripts/verify-production-release-attestation.mjs",
        "scripts/write-production-edge-function-release-attestation.mjs",
        "scripts/write-production-file-worker-release-attestation.mjs",
        "src/components/AdminRndModeToggle.tsx",
        "src/components/AdminRndModeToggle.module.css",
        "supabase/migrations/20260930105423_datanest_release_attestation_v1.sql",
        "tests/unit/forge-evidence-index.test.mjs",
        "tests/unit/mirror-production-promotion.test.mjs",
        "tests/unit/mirror-candidate-boundary-contract.test.mjs",
        "tests/unit/mirror-product-surface-immutability.test.mjs",
        "tests/unit/worktree-gate-timeframes.test.mjs",
        ".github/workflows/knowledge-tree.yml",
        ".github/workflows/boundaries-assessment.yml",
        ".github/workflows/maintenance.yml",
        "boundaries/**",
        "config/boundaries.policy.json",
        "config/knowledge-tree.json",
        "knowledge/**",
        "scripts/boundaries-assessor.mjs",
        "scripts/knowledge-tree.mjs",
        "docs/MAINTENANCE_PROTOCOL.md",
        ".github/workflows/botsquad.yml",
        ".github/workflows/environment-tree.yml",
        "botsquad/**",
        "environment/**",
        "config/botsquad.tree.json",
        "config/environment.tree.json",
        "scripts/botsquad-orchestrator.mjs",
        "scripts/environment-assessor.mjs",
        "tests/unit/botsquad.test.mjs",
        "tests/unit/environment-tree.test.mjs",
        "infra/reson8-forge/specialized-trees.json"
      ]
    },
    {
      "policy": "mirror_only",
      "patterns": [
        ".github/**",
        ".datanest/**",
        "config/mirror-rd-policy.json",
        "docs/MIRROR_DATANEST_RD_MODE.md",
        "docs/PRODUCTION_CANDIDATE_HANDOFF.md",
        "docs/reviews/mirror-*",
        "scripts/lib/mirror-*.mjs",
        "scripts/lib/sync-canonical-files.mjs",
        "scripts/mirror-test-suite.mjs",
        "scripts/validate-mirror-artifact.mjs",
        "tests/unit/mirror-*.test.mjs",
        "tests/unit/repository-boundary.test.mjs",
        "tests/browser/mirror-*.spec.ts",
        "supabase/staging-migrations/**",
        "public/.well-known/reson8-app.json",
        "src/lib/reson8.ts",
        "tests/unit/reson8-integration.test.mjs",
        "README.md",
        ".github/workflows/botsquad-feed-consumer.yml",
        "config/botsquad-consumer.json",
        "botsquad/inbox/**",
        "scripts/botsquad-feed-consumer.mjs",
        "tests/unit/botsquad-feed-consumer.test.mjs"
      ]
    },
    {
      "policy": "protected_shared",
      "patterns": [
        "infra/reson8-forge/README.md",
        "infra/reson8-forge/scripts/backup.sh",
        ".env.example",
        "next.config.ts",
        "scripts/seed-datanest-ai-e2e.mjs",
        "scripts/write-runtime-config.mjs",
        "src/app/globals.css",
        "src/app/layout.tsx",
        "src/components/AuthGate.tsx",
        "src/components/CollaborationVisual.module.css",
        "src/components/CollaborationVisual.tsx",
        "src/components/DataNestApp.tsx",
        "src/components/MotionControl.tsx",
        "src/components/platform/GlobalNavigation.tsx",
        "supabase/functions/_shared/externalAuditAnalysis.ts",
        "tests/browser/auth.smoke.spec.ts",
        "tests/browser/datanest-ai.spec.ts",
        "tests/stress/datanest-ai-backend-acceptance.mjs",
        "tests/stress/datanest-ai-file-stress.mjs",
        "tests/stress/datanest-ai-stress.mjs",
        "tests/unit/datanest-ai-source.test.mjs",
        "tests/unit/datanest-control-center-source.test.mjs",
        "tests/unit/external-audit-analysis.test.mjs",
        "tests/unit/products-source.test.mjs",
        "tests/unit/release-manifest-alignment.test.mjs",
        "tests/unit/sovereign-governance-source.test.mjs",
        "tests/unit/sparks-economy-source.test.mjs",
        "tests/unit/stakeholder-contribution-source.test.mjs",
        "tests/unit/think-tanks-source.test.mjs",
        "tests/unit/transparency-audit-library-source.test.mjs",
        "tests/unit/ui-governance-evidence.test.mjs",
        "tests/unit/ui-production-authorization.test.mjs",
        "tests/unit/ui-ux-source.test.mjs"
      ]
    },
    {
      "policy": "promotable",
      "patterns": [
        "apps/**",
        "data/**",
        "docs/**",
        "infra/**",
        "ops/**",
        "public/**",
        "scripts/**",
        "src/**",
        "supabase/functions/**",
        "supabase/migrations/**",
        "tests/**",
        "config/**",
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "next-env.d.ts",
        "Dockerfile",
        "compose.yaml",
        "playwright.config.ts",
        ".gitignore",
        ".dockerignore",
        ".semgrepignore",
        "workflow-reviewer.config.json",
        "branch-cleaner.config.json",
        "vercel.json"
      ]
    }
  ],
  "classificationSemantics": {
    "promotable": "May cross the Mirror to canonical promotion boundary automatically.",
    "protected_shared": "Intentional environment or governance divergence; must be normalized or explicitly handled before promotion.",
    "mirror_only": "Owned by the Mirror control plane; never promoted or overwritten by a production candidate.",
    "canonical_only": "Owned by the canonical control plane; never introduced by a Mirror candidate.",
    "unclassified": "Fail closed until the path is explicitly classified."
  }
}
